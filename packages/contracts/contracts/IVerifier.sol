pragma solidity ^0.8.28;

/// @title IVerifier
/// @notice ABI of the Groth16 verifier generated by
///         `snarkjs zkey export solidityverifier` (contract `Groth16Verifier`).
/// @dev The generated contract does not inherit this interface, but it is
///      ABI-compatible, so `Voting` can call it through `IVerifier`.
///      PLACEHOLDER: the array length of `pubSignals` equals the circuit's
///      number of public signals (currently assumed 4, see IVoting.sol).
///      Update it if the circuit changes.
interface IVerifier {
    function verifyProof(
        uint256[2] calldata pA,
        uint256[2][2] calldata pB,
        uint256[2] calldata pC,
        uint256[4] calldata pubSignals
    ) external view returns (bool);
}
