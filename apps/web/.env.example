# ─────────────────────────────────────────────────────────────────────────────
# apps/web ortam değişkenleri — ŞABLON. Gerçek değerleri buraya YAZMAYIN.
#   cp apps/web/.env.example apps/web/.env.local
# .env.local git tarafından yok sayılır (.gitignore → .env*).
# Hiçbir değişken NEXT_PUBLIC_ önekli değildir; hepsi yalnızca sunucuda okunur.
# ─────────────────────────────────────────────────────────────────────────────

# Zincir bağlantısı:
#   mock → bellek içi sahte zincir (varsayılan; başka değişken gerekmez)
#   rpc  → gerçek sözleşme; aşağıdaki RPC değişkenleri zorunlu olur
CHAIN_MODE=mock

# Yönetici API'si (/admin sayfası) için paylaşılan anahtar, en az 16 karakter.
# Üretmek için: openssl rand -hex 32
# Boş bırakılırsa yönetici API'si kapalıdır.
ADMIN_TOKEN=

# ── Yalnızca CHAIN_MODE=rpc ──────────────────────────────────────────────────

# Sepolia: https://eth-sepolia.g.alchemy.com/v2/<ALCHEMY_API_KEY>
# Yerel Hardhat ağı (pnpm chain): http://127.0.0.1:8545
ALCHEMY_RPC_URL=

# Sepolia: 11155111 · Yerel Hardhat: 31337
CHAIN_ID=11155111

# Dağıtılan Voting sözleşmesinin adresi (0x…).
CONTRACT_ADDRESS=

# Sözleşmenin dağıtıldığı blok; oy takibindeki olay sorgusunu kısaltır.
CONTRACT_DEPLOY_BLOCK=0

# Relayer cüzdanının özel anahtarı (0x + 64 hex). Bu cüzdan gas öder.
# UYARI: Yalnızca bu proje için açılmış, içinde yalnızca test ağı ETH'si olan
# bir cüzdan kullanın. Kişisel cüzdanınızın anahtarını asla girmeyin.
# Yerel ağ için `pnpm chain` çıktısındaki test hesaplarından birini kullanın.
RELAYER_PRIVATE_KEY=
